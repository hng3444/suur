# Host port exposed by Docker
SUUR_PORT=3721

# Public URL seen by browsers (use your HTTPS URL behind a reverse proxy)
SUUR_PUBLIC_URL=http://localhost:3721

# Initial superadmin account. These values are only used when the database is first created.
# Change the password immediately after the first sign-in.
SUUR_DEFAULT_USERNAME=alaferoce
SUUR_DEFAULT_PASSWORD=7Admin7

# Maximum size of one uploaded image, audio recording, PDF, or document (MB)
SUUR_MAX_UPLOAD_MB=25

# Enable only when Suur is reachable exclusively through a trusted reverse proxy.
# This lets login protection use Cloudflare/X-Real-IP headers safely.
SUUR_TRUST_PROXY=false

# Optional comma-separated exact origins for custom mobile/web clients.
# Capacitor's standard localhost origins already work without configuration.
SUUR_ALLOWED_APP_ORIGINS=

# Development only. Keep false for every internet-facing installation.
SUUR_ALLOW_INSECURE_MOBILE=false

# Resource safety limits
SUUR_NOTE_HISTORY_LIMIT=100
SUUR_MAX_NOTES_PER_USER=50000

# Persistent Docker volume name
SUUR_VOLUME_NAME=suur-data
