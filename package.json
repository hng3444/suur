{
  "name": "suur",
  "version": "0.3.2",
  "description": "A fast, private, multilingual, self-hosted notes app with offline-first PWA support.",
  "keywords": [
    "self-hosted",
    "notes",
    "note-taking",
    "pwa",
    "offline-first",
    "docker",
    "casaos",
    "google-keep-alternative",
    "sqlite"
  ],
  "homepage": "https://github.com/hng3444/suur",
  "repository": {
    "type": "git",
    "url": "https://github.com/hng3444/suur.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "better-sqlite3": "^12.4.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.544.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module"
}
